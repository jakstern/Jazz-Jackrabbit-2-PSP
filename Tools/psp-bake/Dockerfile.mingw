# Windows cross-compilation image for the psp-bake host tool.
#
# Provides MinGW-w64 plus statically built zlib and libxmp, so the resulting
# psp-bake.exe is a single self-contained binary with no DLLs to redistribute.
#
# Built and used by Tools/psp-bake/Makefile:
#   make -C Tools/psp-bake windows

FROM debian:stable-slim

ARG ZLIB_VERSION=1.3.1
ARG LIBXMP_VERSION=4.6.3
ARG MINGW_TRIPLE=x86_64-w64-mingw32
ARG MINGW_PREFIX=/opt/mingw64

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
		ca-certificates \
		cmake \
		curl \
		file \
		g++ \
		make \
		mingw-w64 \
		pkg-config \
		xz-utils \
	&& rm -rf /var/lib/apt/lists/*

# zlib: built through its own MinGW makefile, installed as a plain static
# libz.a so that CMake's FindZLIB picks it up without extra hints.
RUN set -eux; \
	curl -fsSL -o /tmp/zlib.tar.gz \
		"https://zlib.net/fossils/zlib-${ZLIB_VERSION}.tar.gz" \
		|| curl -fsSL -o /tmp/zlib.tar.gz \
			"https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/zlib-${ZLIB_VERSION}.tar.gz"; \
	tar -xzf /tmp/zlib.tar.gz -C /tmp; \
	cd "/tmp/zlib-${ZLIB_VERSION}"; \
	make -f win32/Makefile.gcc -j"$(nproc)" PREFIX="${MINGW_TRIPLE}-" libz.a; \
	install -Dm644 libz.a "${MINGW_PREFIX}/lib/libz.a"; \
	install -Dm644 zlib.h "${MINGW_PREFIX}/include/zlib.h"; \
	install -Dm644 zconf.h "${MINGW_PREFIX}/include/zconf.h"; \
	rm -rf /tmp/zlib*

# libxmp: the same tracker decoder the PSP build and the Linux build use, so
# host-baked and on-device caches stay bit-compatible.
RUN set -eux; \
	curl -fsSL -o /tmp/libxmp.tar.gz \
		"https://github.com/libxmp/libxmp/releases/download/libxmp-${LIBXMP_VERSION}/libxmp-${LIBXMP_VERSION}.tar.gz" \
		|| curl -fsSL -o /tmp/libxmp.tar.gz \
			"https://downloads.sourceforge.net/project/xmp/libxmp/${LIBXMP_VERSION}/libxmp-${LIBXMP_VERSION}.tar.gz"; \
	tar -xzf /tmp/libxmp.tar.gz -C /tmp; \
	cd "/tmp/libxmp-${LIBXMP_VERSION}"; \
	./configure \
		--host="${MINGW_TRIPLE}" \
		--prefix="${MINGW_PREFIX}" \
		--enable-static \
		--disable-shared; \
	make -j"$(nproc)"; \
	make install; \
	rm -rf /tmp/libxmp*

ENV PSP_BAKE_MINGW_PREFIX="${MINGW_PREFIX}"
ENV PKG_CONFIG_PATH="${MINGW_PREFIX}/lib/pkgconfig"

WORKDIR /src
